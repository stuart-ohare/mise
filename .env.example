# Copy to .env.local. Never commit the real file.

# Matches docker-compose.yml. If you set POSTGRES_PORT, change the port here too.
DATABASE_URL=postgresql://mise:mise@localhost:5432/mise

# Neon (deployed): use the pooled string — host contains `-pooler` — and keep
# `sslmode=require`; Neon refuses unencrypted connections. The `channel_binding=require`
# Neon adds is fine with postgres-js as-is. See README → Deploying.
# DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require

ANTHROPIC_API_KEY=
